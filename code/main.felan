@import("basic.felan");

t :: (comptime formatter : string) -> void {
  i := 0;
  in := 0;
  opening := 0;
  while @cast(i,u64) < formatter.length {
    c := formatter[i];
    if c == '{' {
      if in == 0 {
        opening = i+1;
      }
      in += 1;
    } else if c == '}' {
      in -= 1;
      if in == 0{
        str := sub_string(formatter,opening,i);
        print(str);
      } else if in < 0 {
        in = 0;
      }
    }
    i += 1;
  }
};

main :: () -> void {
  t("hello {world}");
};

