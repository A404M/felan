@import("basic.felan");

print :: (value:**anytype)->void{
  if comptime @type_of(value.*) == u8 {
    @putc(value.*);
  }else{
    @putc('h');
  }
};

st :: struct {
};

__get_item__ :: (left:st,index:i64,index2:i64)->i64{
  return index+index2;
};

main :: () -> void {
  a : st = undefined;
  print(a[1,2]);
};

