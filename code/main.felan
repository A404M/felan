@import("lib/operator.felan");

/*
print :: (value:anytype) -> void {
  if comptime @type_of(value) == u8 {
    @putc(value);
  }else{
    @putc('h');
  }
};
*/

print :: (value:*anytype)->void{
  if comptime @type_of(value.*) == u8 {
    @putc(value.*);
  }else{
    @putc('h');
  }
};

main :: ()->void{
  a := 'a';
  b := 123;
  print(&a);
  print(&b);
  // print(123);
};

