// @import("lib/memory.felan");
@import("lib/operator.felan");

print :: (value:**anytype)->void{
  if comptime @type_of(value.*) == u8 {
    @putc(value.*);
  }else{
    @putc('h');
  }
};

main :: () -> void {
  a := @stack_alloc(10,u8);
  a[0] = '1';
  b := &a[2];
  b.* = '9';
  @putc(a[0]);
  @putc(b.*);
};

