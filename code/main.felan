@import("basic.felan");

t :: (comptime formatter : string) -> string {
  i := 0;
  in := 0;
  opening := 0;
  while @cast(i,u64) < formatter.length {
    c := formatter[i];
    if c == '{' {
      if in == 0 {
        opening = i+1;
      }
      in += 1;
    } else if c == '}' {
      in -= 1;
      if in == 0{
        str := sub_string(formatter,opening,i);
        return str;
      } else if in < 0 {
        in = 0;
      }
    }
    i += 1;
  }
  return "a = '6';";
};

main :: () -> void {
  a := '2';
  // @insert("a = '3';a = '5';");
  s :: t("hello {a = '1';}");
  @insert(s);
  print_char(a);
};

p :: (comptime s:string)->void{
  print(1234);
};

