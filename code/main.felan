@import("basic.felan");

t :: (comptime formatter : string) -> void {
  i := 0;
  in := 0;
  opening := 0;
  while @cast(i,u64) < formatter.length {
    c := formatter[i];
    if c == '{' {
      if in == 0 {
        opening = i+1;
      }
      in += 1;
    } else if c == '}' {
      in -= 1;
      if in == 0{
        str := sub_string(formatter,opening,i);
        print(str);
      } else if in < 0 {
        in = 0;
      }
    }
    i += 1;
  }
};

sub_string :: (str:string, begin:i64, end:i64) -> string {
  result := "";
  result.ptr = str.ptr + begin;
  result.length = @cast(end-begin,u64);
  return result;
};

main :: () -> void {
  a := '2';
  // @insert("a = '3';a = '5';");
  // @putc(a);
  println(a);
  b := &a;
  println(b.*);
  println(a);
  b.* = '5';
  println(b.*);
  arr :[10]u8= undefined;
  arr[0] = '6';
  @putc(arr[0]);
  // t("hello {world}");
