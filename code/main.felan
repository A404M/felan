@import("basic.felan");

print :: (value:**anytype)->void{
  if comptime @type_of(value.*) == u8 {
    @putc(value.*);
  }else{
    @putc('h');
  }
};

__sum__ :: (left:*anytype,right:i64) -> (@type_of(left)) {
  return @add(left,right);
};

main :: ()->void{
  arr :[10]i64= undefined;
  arr[0] = 2;
  arr[1] = 3;
  p := &arr[0];
  p += 1;
  print(p.*);
};

