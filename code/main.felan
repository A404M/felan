@import("basic.felan");
file :: @import("file.felan");

t :: (comptime formatter : string) macro -> string {
  i := 0;
  in := 0;
  opening := 0;
  while @cast(i,u64) < formatter.length {
    c := formatter[i];
    if c == '{' {
      if in == 0 {
        opening = i+1;
      }
      in += 1;
    } else if c == '}' {
      in -= 1;
      if in == 0 {
        return sub_string(formatter,opening,i);
      } else if in < 0 {
        in = 0;
      }
    }
    i += 1;
  }
  return "";
};

main :: () -> void {
  arr :[10][]u8 = undefined;
  arr[0] = "Hello";
  print(arr[0]);
};

